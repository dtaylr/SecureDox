{
  "name": "securedox",
  "private": true,
  "version": "0.1.0",
  "description": "SecureDox — AI Reliability TestOps Platform for a regulated document intake workflow",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "yarn": ">=1.22"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/mcp-test-architect",
    "packages/shared/ts",
    "packages/observability/ts",
    "packages/test-framework",
    "tests/e2e",
    "tests/contract",
    "tests/security",
    "tests/mobile-ui",
    "tests/architecture"
  ],
  "scripts": {
    "up": "docker compose -f infra/docker/docker-compose.yml up -d --build",
    "down": "docker compose -f infra/docker/docker-compose.yml down -v",
    "logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "seed": "docker compose -f infra/docker/docker-compose.yml exec api python -m app.db.seed",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test:e2e": "yarn workspace @securedox/e2e-tests test",
    "test:contract": "yarn workspace @securedox/contract-tests test",
    "test:security": "yarn workspace @securedox/security-tests test",
    "test:mcp": "yarn workspace @securedox/mcp-test-architect test",
    "test:agents": "node --experimental-strip-types tests/agents/agent-helper-scripts.test.ts && node --experimental-strip-types tests/agents/agent-assets.test.ts",
    "mcp:test-architect": "yarn workspace @securedox/mcp-test-architect start",
    "agents:changed-files": "node --experimental-strip-types scripts/agents/changed-files.ts",
    "agents:impacted-tests": "node --experimental-strip-types scripts/agents/impacted-tests.ts",
    "agents:release-gates": "node --experimental-strip-types scripts/agents/release-gate-selector.ts",
    "agents:validate-assets": "node --experimental-strip-types scripts/agents/validate-agent-assets.ts",
    "test:bdd": "yarn workspace @securedox/e2e-tests test:bdd",
    "test:mobile:ui": "yarn workspace @securedox/mobile-ui-tests test",
    "test:arch": "yarn workspace @securedox/architecture-tests test",
    "contracts:types": "openapi-typescript packages/contracts/openapi/securedox.v1.yaml -o packages/shared/ts/src/generated/api.ts",
    "gate:release": "tsx scripts/release-readiness.ts",
    "gate:security": "tsx scripts/security-release-gate.ts",
    "check:flake": "tsx scripts/check-flake-rate.ts",
    "check:coverage": "tsx scripts/check-coverage-regression.ts"
  },
  "resolutions": {
    "js-yaml": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
