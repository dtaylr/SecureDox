# ---------------------------------------------------------------------------
# SecureDox — local environment template.
# Copy to `.env` (git-ignored) and adjust. Never commit real secrets.
# Every value here is a throwaway local credential; gitleaks allowlists this file.
# ---------------------------------------------------------------------------

# --- Core ---
SECUREDOX_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Postgres ---
POSTGRES_USER=securedox
POSTGRES_PASSWORD=securedox_local_pw
POSTGRES_DB=securedox
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://securedox:securedox_local_pw@postgres:5432/securedox
# Sync URL used by Alembic and the DB validation test suite.
DATABASE_URL_SYNC=postgresql+psycopg://securedox:securedox_local_pw@postgres:5432/securedox

# --- Redis / queue ---
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=securedox:intake

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# HS256 signing key for the demo auth shim. Rotate per environment.
AUTH_JWT_SECRET=local-dev-only-not-a-real-secret
AUTH_JWT_ISSUER=securedox-local
AUTH_TOKEN_TTL_SECONDS=3600

# --- Document storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/lib/securedox/storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/tiff

# --- OCR adapter ---
# mock      -> deterministic fixture-driven extraction (default; CI-safe, no network)
# tesseract -> local tesseract binary
# vendor    -> HTTP OCR vendor behind OCR_VENDOR_URL
OCR_PROVIDER=mock
OCR_VENDOR_URL=
OCR_VENDOR_API_KEY=
OCR_TIMEOUT_SECONDS=30
OCR_CONFIDENCE_THRESHOLD=0.80

# --- Worker ---
WORKER_CONCURRENCY=4
WORKER_MAX_RETRIES=3
WORKER_JOB_TIMEOUT_SECONDS=120

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENV=local

# --- Mobile (Expo) ---
# Android emulator reaches the host through 10.0.2.2; iOS simulator uses localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Observability ---
OTEL_SERVICE_NAME=securedox
METRICS_ENABLED=true
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --- AI TestOps (MCP test architect) ---
# Required only when running the MCP server's generation tools.
ANTHROPIC_API_KEY=
MCP_MODEL=claude-sonnet-5
MCP_HUMAN_APPROVAL_REQUIRED=true
MCP_GENERATED_TEST_DIR=tests/_generated

# --- Release gates (thresholds consumed by scripts/*.ts) ---
GATE_MIN_COVERAGE=80
GATE_MAX_COVERAGE_DROP=1.0
GATE_MAX_FLAKE_RATE=2.0
GATE_MAX_P95_MS=800
GATE_MAX_OCR_P95_MS=5000
GATE_BLOCK_ON=CRITICAL,HIGH
