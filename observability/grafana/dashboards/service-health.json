{
  "uid": "securedox-service-health",
  "title": "SecureDox Service Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["securedox", "sre"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total[5m])) by (route, status)" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p95 Latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue Depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "securedox_queue_depth" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Document Processing p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(document_processing_duration_seconds_bucket[5m])) by (le, document_type))" }]
    }
  ]
}
